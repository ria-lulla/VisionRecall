<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>VisionRecall</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- Permissions used by the demo. Explain each in-app before invoking the system prompt. -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>VisionRecall uses your home/away location so departure reminders trigger at the right moment. Location stays on this device.</string>
    <key>NSCameraUsageDescription</key>
    <string>VisionRecall uses the glasses camera to match visual memory keys on-device. Frames are not uploaded.</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>VisionRecall connects to your Meta glasses over Bluetooth.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>VisionRecall streams photos from your Meta glasses over Wi-Fi.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_bonjour._tcp</string>
    </array>

    <!-- Glasses connect as an external accessory over Bluetooth Classic. -->
    <key>UISupportedExternalAccessoryProtocols</key>
    <array>
        <string>com.meta.ar.wearable</string>
    </array>
    <key>UIBackgroundModes</key>
    <array>
        <string>bluetooth-peripheral</string>
        <string>external-accessory</string>
    </array>

    <!-- Lets the SDK detect and open the Meta AI app via canOpenURL during registration. -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>fb-viewapp</string>
    </array>

    <!-- Custom URL scheme so the Meta AI app can call back during registration. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLName</key>
            <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>visionrecall</string>
            </array>
        </dict>
    </array>

    <!-- Device Access Toolkit configuration. MetaAppID is "0" for Developer Mode;
         use the Wearables Developer Center APPLICATION_ID (plus ClientToken/TeamID
         for attestation) for production builds. -->
    <key>MWDAT</key>
    <dict>
        <key>AppLinkURLScheme</key>
        <string>visionrecall://</string>
        <key>MetaAppID</key>
        <string>$(META_APP_ID)</string>
        <!-- Opt out of DAT telemetry to keep the prototype local-first. -->
        <key>Analytics</key>
        <dict>
            <key>OptOut</key>
            <true/>
        </dict>
    </dict>
</dict>
</plist>
